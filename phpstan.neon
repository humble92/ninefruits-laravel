includes:
    - vendor/larastan/larastan/extension.neon

rules:
    - Tools\PHPStan\Rules\NoDynamicRawSqlRule
    - Tools\PHPStan\Rules\RuleEngineAnswersOnlyInSeedersRule
    - Tools\PHPStan\Rules\RuleEngineAnswersCallableOnlyInSeedersRule

parameters:
    level: 6
    paths:
        - app
        - database/factories
        - database/seeders
        - tools/phpstan
    tmpDir: storage/framework/cache/phpstan
